{
  "name": "dsh-smart-reminder",
  "version": "0.1.17",
  "description": "Smart calendar reminder & schedule assistant for DSH Web GUI: lunar calendar, holidays, system notifications on macOS/Windows, and WeCom/platform push integration.",
  "license": "MIT",
  "author": "Jaden Tang <jaden.tang@sjfood.com>",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "assets/DSHReminder.app",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/smoke-test.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-client-runtime": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.6 <0.3.0",
    "@deepseek-ai/schemastery": "^3.0.0",
    "react": ">=16.8.0 <20.0.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-locale": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "^0.25.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.6.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a792883583/dsh-smart-reminder.git"
  },
  "homepage": "https://github.com/a792883583/dsh-smart-reminder",
  "keywords": [
    "dsh",
    "plugin",
    "reminder",
    "calendar",
    "lunar",
    "holidays",
    "notifications",
    "wecom"
  ],
  "engines": {
    "node": ">=22"
  }
}